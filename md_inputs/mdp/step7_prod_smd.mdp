integrator              = md
dt                      = 0.002
nsteps                  = 25000000     ; 50 ns
nstfout                 = 0       ; save forces every 10.0 ps
nstvout                 = 0       ; save velocities every 1.0 ps
nstenergy               = 0       ; save energies every 50.0 ps
nstlog                  = 25000   ; update log file every 50.0 ps
nstxout-compressed      = 25000   ; save coordinates every 50.0 ps
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
;
tcoupl                  = V-rescale
tc_grps                 = MEMB SOLV
tau_t                   = 1.0 1.0
ref_t                   = 310 310
;
pcoupl                  = C-rescale
pcoupltype              = semiisotropic
tau_p                   = 5.0
compressibility         = 4.5e-5  4.5e-5
ref_p                   = 1.0     1.0
;
constraints             = h-bonds
constraint_algorithm    = LINCS
continuation            = yes
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = MEMB SOLV

pull                    = yes
pull-ncoords            = 1
pull-ngroups            = 2
pull-coord1-type        = umbrella
pull_coord1_geometry    = distance
pull-group1-name        = LIG
pull-group2-name        = MEMB
pull_group1_pbcatom     = 15134
pull_group2_pbcatom     = 3216
pull-pbc-ref-prev-step-com = yes
pull_coord1_groups      = 1 2       ; 与此牵引坐标作用的组的索引
pull_coord1_dim         = N N Y     ; 选择此牵引坐标作用的维度，分别对应X,Y,Z三个分量（N表示关闭，Y表示开启）
pull_coord1_rate        = -0.0001   ; 牵引速率（nm/ps,度/ps)
pull-coord1-k           = 1000.0
pull-coord1-init        = 4.1
